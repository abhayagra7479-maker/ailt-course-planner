# AILT Course Planner AI — configuration
# Copy this file to ".env" and paste your API key below.

# --- AI natural-language course search ---
# Your API key for any OpenAI-compatible chat API
# (OpenAI, DeepSeek, Moonshot/Kimi, etc.)
AI_API_KEY=sk-your-key-here

# Optional: point at any OpenAI-compatible endpoint
# AI_BASE_URL=https://api.openai.com/v1

# Optional: choose the chat model used for search
# AI_MODEL=gpt-4o-mini
